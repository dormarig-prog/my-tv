              },
              {
                "type": "button",
                "layout": "0,4,6,1",
                "label": "Обновить меню",
                "action": "reload"
              },
              {
                "type": "button",
                "layout": "6,4,6,1",
                "label": "Все приложения",
                "action": "content:https://dormarig-prog.github.io/my-tv/all-apps.json"
